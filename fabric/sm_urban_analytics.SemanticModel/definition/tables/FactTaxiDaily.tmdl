table FactTaxiDaily
	lineageTag: fda1b6d9-202f-4a2a-895e-feb57e3ab0a9
	sourceLineageTag: [dbo].[FactTaxiDaily]

	measure 'Total Trips' = SUM(FactTaxiDaily[trip_count])
		formatString: #,0
		lineageTag: 9c993a27-b058-42cc-8666-0ebb0262d034

		changedProperty = Name

		changedProperty = FormatString

	measure 'Total Revenue USD' = SUM(FactTaxiDaily[total_amount_usd])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 4a42cc66-d15b-483c-8ef1-f6d1a8aacce4

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Revenue EUR' = SUMX(VALUES(DimDate[date_key]), DIVIDE([Total Revenue USD], [USD per EUR]))
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 82702bb0-924a-472d-8671-01e2620fb28b

		changedProperty = Name

		changedProperty = FormatString

	measure 'Avg Fare USD' = DIVIDE([Total Revenue USD], [Total Trips])
		formatString: 0.00
		lineageTag: b1515b53-25e8-4399-a873-6398f6e48466

		changedProperty = Name

		changedProperty = FormatString

	measure 'Avg Trip Distance Miles' = DIVIDE(SUM(FactTaxiDaily[total_distance_miles]), [Total Trips])
		formatString: 0.00
		lineageTag: 9dda85ba-53e7-4798-87f2-1e3654242bcc

		changedProperty = Name

		changedProperty = FormatString

	measure 'Avg Trip Duration Minutes' = DIVIDE(SUM(FactTaxiDaily[total_duration_seconds]), [Total Trips]) / 60
		formatString: 0.0
		lineageTag: 186cc9f6-b3fc-4136-a45d-b1a885a74128

		changedProperty = Name

		changedProperty = FormatString

	measure 'Avg Passengers' = DIVIDE(SUM(FactTaxiDaily[total_passengers]), SUM(FactTaxiDaily[trips_with_passenger_count]))
		formatString: 0.00
		lineageTag: 6f77bc57-2361-47c7-9bc0-ba6a18669dc9

		changedProperty = Name

		changedProperty = FormatString

	measure 'Tip Share' = DIVIDE(SUM(FactTaxiDaily[total_tip_usd]), SUM(FactTaxiDaily[total_fare_usd]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: efe21089-d975-4897-bf55-d0b77823158d

		changedProperty = Name

		changedProperty = FormatString

